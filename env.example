# Translation API key used to authenticate with your chosen translation service
# For RapidAPI "Rapid Translate Multi Traduction", this is your X-RapidAPI-Key value.
TRANSLATE_API_KEY=your-translate-api-key-here

# Base URL/endpoint for the translation API (see provider docs)
# For Rapid Translate Multi Traduction, this would be:
# https://rapid-translate-multi-traduction.p.rapidapi.com/t
TRANSLATE_API_URL=https://rapid-translate-multi-traduction.p.rapidapi.com/t

# Host header for the translation API (if required by the provider)
# For Rapid Translate Multi Traduction, this is:
# rapid-translate-multi-traduction.p.rapidapi.com
TRANSLATE_API_HOST=rapid-translate-multi-traduction.p.rapidapi.com

# BrowserStack username from your Automate dashboard
BROWSERSTACK_USERNAME=your-browserstack-username

# BrowserStack access key from your Automate dashboard
BROWSERSTACK_ACCESS_KEY=your-browserstack-access-key

# Optional: label used to group BrowserStack test runs
BROWSERSTACK_BUILD_NAME=el-pais-scraper-build-1

# Directory (relative or absolute) where article cover images will be saved
IMAGES_DIR=images

# Base URL for the El País site
EL_PAIS_BASE_URL=https://elpais.com/

# Default implicit wait time (in seconds) for Selenium element searches
SELENIUM_IMPLICIT_WAIT_SECONDS=10

# Default page load timeout (in seconds) for Selenium
PAGE_LOAD_TIMEOUT_SECONDS=60

